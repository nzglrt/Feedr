<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingEnd="16dp" android:background="@color/bg">
    <TextView
        android:id="@+id/handle"
        android:layout_width="56dp" android:layout_height="match_parent"
        android:gravity="center" android:text="≡"
        android:textColor="@color/muted" android:textSize="24sp" />
    <TextView
        android:id="@+id/name"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text" android:textSize="16sp" />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
